@article{GuimaraesFigueiredoWoodward:2003,
  author =        {Guimar{\~a}es, Paulo and Figueiredo, Oct{\'a}vio and
                   Woodward, Douglas},
  journal =       {The Review of Economics and Statistics},
  number =        {1},
  pages =         {201-204},
  title =         {A Tractable Approach to the Firm Location Decision
                   Problem},
  volume =        {85},
  year =          {2003},
  abstract =      {The conditional logit model based on random utility
                   maximization has provided an adequate framework to
                   model firm location decisions. However, in practice,
                   the implementation of this methodology presents
                   problems when one has to handle complex choice
                   scenarios with a large number of spatial
                   alternatives. We posit the Poisson regression as a
                   tractable solution to these problems. We demonstrate
                   that by taking advantage of an equivalence relation
                   between the likelihood function of the conditional
                   logit and the Poisson regression we can, under
                   certain circumstances, easily estimate a conditional
                   logit model regardless of the number of choices. This
                   insight should be particularly useful for studies of
                   economic location.},
  doi =           {10.1162/003465303762687811},
  url =           {https://doi.org/10.1162/003465303762687811},
}

