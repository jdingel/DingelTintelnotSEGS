@article{CorreiaGuimaraesZylkin:2020,
  author =        {Sergio Correia and Paulo Guimar{\~a}es and
                   Tom Zylkin},
  journal =       {The Stata Journal},
  number =        {1},
  pages =         {95-115},
  title =         {Fast Poisson estimation with high-dimensional fixed
                   effects},
  volume =        {20},
  year =          {2020},
  abstract =      {In this article, we present ppmlhdfe, a new command
                   for estimation of (pseudo-)Poisson regression models
                   with multiple high-dimensional fixed effects (HDFE).
                   Estimation is implemented using a modified version of
                   the iteratively reweighted least-squares algorithm
                   that allows for fast estimation in the presence of
                   HDFE. Because the code is built around the reghdfe
                   package (Correia, 2014, Statistical Software
                   Components S457874, Department of Economics, Boston
                   College), it has similar syntax, supports many of the
                   same functionalities, and benefits from reghdfe`s
                   fast convergence properties for computing
                   high-dimensional leastsquares problems. Performance
                   is further enhanced by some new techniques we
                   introduce for accelerating HDFE iteratively
                   reweighted least-squares estimation specifically.
                   ppmlhdfe also implements a novel and more robust
                   approach to check for the existence of
                   (pseudo)maximum likelihood estimates.},
  doi =           {10.1177/1536867X20909691},
  url =           {https://doi.org/10.1177/1536867X20909691},
}

@article{SilvaTenreyro:2006,
  author =        {J. M. C. Santos Silva and Silvana Tenreyro},
  journal =       {The Review of Economics and Statistics},
  month =         {November},
  number =        {4},
  pages =         {641-658},
  title =         {{The Log of Gravity}},
  volume =        {88},
  year =          {2006},
  abstract =      {Although economists have long been aware of Jensen's
                   inequality, many econometric applications have
                   neglected an important implication of it: under
                   heteroskedasticity, the parameters of log-linearized
                   models estimated by OLS lead to biased estimates of
                   the true elasticities. We explain why this problem
                   arises and propose an appropriate estimator. Our
                   criticism of conventional practices and the proposed
                   solution extend to a broad range of applications
                   where log-linearized equations are estimated. We
                   develop the argument using one particular
                   illustration, the gravity equation for trade. We find
                   significant differences between estimates obtained
                   with the proposed estimator and those obtained with
                   the traditional method. Copyright by the President
                   and Fellows of Harvard College and the Massachusetts
                   Institute of Technology.},
  url =           {https://ideas.repec.org/a/tpr/restat/v88y2006i4p641-
                  658.html},
}

